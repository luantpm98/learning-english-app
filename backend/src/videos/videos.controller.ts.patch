+  @Post('translate')
+  async translateText(@Body('text') text: string) {
+    try {
+      const encodedText = encodeURIComponent(text);
+      const url = `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=vi&dt=t&q=${encodedText}`;
+      const res = await axios.get(url);
+      const translated = res.data[0].map((t: any) => t[0]).join('');
+      return { text: translated };
+    } catch (e) {
+      return { text: "Lỗi dịch thuật" };
+    }
+  }
